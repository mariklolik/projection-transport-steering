  "reproduction_code": "import hashlib,itertools,json,math,statistics\nfrom pathlib import Path\nroot=Path(\".\")\ndirectory=root/\"artifacts/engineering/irc_static_fit_v1/probe\"\nsha=lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\nconfig_path=root/\"research/irc-static-fit-config-v1.json\"\nconfig=json.loads(config_path.read_text())\nreceipt=json.loads((directory/\"receipt.json\").read_text())\ncapture=json.loads((directory.parent/\"gpu-capture.json\").read_text())\nassert receipt[\"status\"]==\"pass\" and not receipt[\"baseline_eligible\"]\nassert receipt[\"config_sha256\"]==sha(config_path)\nassert receipt[\"source_sha256\"]==config[\"source_sha256\"]\nassert all(sha(root/p)==h for p,h in config[\"source_sha256\"].items())\nassert receipt[\"versions\"]==config[\"expected_versions\"]\nexpected={f\"{a}-{g}-{i}.json\" for a,g,i in itertools.product(config[\"applications\"],config[\"groups\"],range(config[\"repeats\"]))}\nassert expected==set(receipt[\"step_sha256\"])\nassert {p.name for p in directory.glob(\"*.json\")}==expected|{\"receipt.json\"}\nsteps=[]\nfor name in sorted(expected):\n p=directory/name\n assert sha(p)==receipt[\"step_sha256\"][name]\n row=json.loads(p.read_text())\n assert name==f'{row[\"application\"]}-{row[\"group\"]}-{row[\"repeat\"]}.json'\n target=sum(x[\"target_tokens\"] for x in config[\"expected_lengths\"][row[\"group\"]])\n positions=28+(target if row[\"application\"]==\"full\" else 0)\n width=128*math.ceil(max(x[\"total_tokens\"] for x in config[\"expected_lengths\"][row[\"group\"]])/128)\n assert row[\"target_tokens\"]==target and row[\"active_positions\"]==positions\n assert row[\"padded_shape\"]==[2,width]\n assert all(math.isfinite(row[k]) and row[k]>0 for k in [\"loss\",\"gradient_norm\",\"seconds\",\"peak_memory_bytes\"])\n assert row[\"changed_parameters\"]==3\n steps.append(row)\nlogs=[json.loads(line) for line in capture[\"logs_stdout\"].splitlines() if line.startswith(\"{\")]\nassert len(logs)==20\nassert sorted(logs[:-2],key=lambda x:(x[\"application\"],x[\"group\"],x[\"repeat\"]))==steps\nassert logs[-2]=={\"event\":\"fit_probe_complete\",\"status\":\"pass\",\"steps\":18}\nstate=capture[\"inspect\"][0][\"State\"]\nassert not state[\"Running\"] and not state[\"OOMKilled\"] and state[\"ExitCode\"]==1\ndef nanos(t):\n from datetime import datetime,timezone\n main,fraction=t.rstrip(\"Z\").split(\".\")\n return int(datetime.strptime(main,\"%Y-%m-%dT%H:%M:%S\").replace(tzinfo=timezone.utc).timestamp())*10**9+int(fraction.ljust(9,\"0\"))\ncontainer_s=(nanos(state[\"FinishedAt\"])-nanos(state[\"StartedAt\"]))/10**9\ncells=[]\nfor application,group in itertools.product(config[\"applications\"],config[\"groups\"]):\n rows=sorted([x for x in steps if (x[\"application\"],x[\"group\"])==(application,group)],key=lambda x:x[\"repeat\"])\n cells.append({\"application\":application,\"group\":group,\"padded_shape\":rows[0][\"padded_shape\"],\"first_in_cell_seconds\":rows[0][\"seconds\"],\"warm_seconds\":[x[\"seconds\"] for x in rows[1:]],\"warm_mean_seconds\":statistics.mean(x[\"seconds\"] for x in rows[1:]),\"losses\":[x[\"loss\"] for x in rows],\"target_tokens_each\":rows[0][\"target_tokens\"],\"active_positions_each\":rows[0][\"active_positions\"]})\nresult={\"schema\":\"irc-static-fit-result-audit-v1\",\"status\":\"failed_trajectory_parity\",\"receipt_sha256\":sha(directory/\"receipt.json\"),\"config_sha256\":sha(config_path),\"capture_sha256\":sha(directory.parent/\"gpu-capture.json\"),\"step_sha256\":receipt[\"step_sha256\"],\"source_hash_count\":len(receipt[\"source_sha256\"]),\"complete_steps\":len(steps),\"unique_questions\":len(set(itertools.chain.from_iterable(config[\"groups\"].values()))),\"supervised_token_instances\":sum(x[\"target_tokens\"] for x in steps),\"cells\":cells,\"adapter_parameters\":receipt[\"adapter_parameters\"],\"base_parameter_versions_unchanged\":receipt[\"base_parameter_versions_unchanged\"],\"container_seconds\":container_s,\"runner_seconds\":receipt[\"total_elapsed_seconds\"],\"summed_step_seconds\":sum(x[\"seconds\"] for x in steps),\"peak_memory_bytes\":max(x[\"peak_memory_bytes\"] for x in steps),\"known_stage_h100_hours\":0.8445338963775001+container_s/3600,\"historical_overhead_reserve_hours\":0.1,\"stage_ceiling_hours\":1,\"baseline_eligible\":False,\"statistical_scope\":\"Six purposively selected fit questions; two sequential policies in one process; no independent timing interval or efficacy estimate\",\"memory_scope\":\"Cumulative post-load torch max_memory_allocated, not per-cell isolated peak or all GPU-resident memory\",\"base_mutation_scope\":\"Parameter-version plus gradient and optimizer-ownership checks, not cryptographic comparison of every base byte\",\"remaining_gates\":[\"Accumulated trainer and full fit schedule\",\"Held-out fixed-control selection\",\"Useful full-generation static action\",\"IRC behavioral efficacy\",\"Strongest-comparator resource frontier\",\"Three architecture families and three behavior constructs\"],\"sota_achieved\":False}\ncomparison=logs[-1]\nassert comparison[\"event\"]==\"static_fit_comparison\" and comparison[\"status\"]==\"fail\" and comparison[\"compiler_callable_unchanged\"]\nassert len(comparison[\"comparisons\"])==18\nprior=root/\"artifacts/engineering/irc_fit_probe_v1/probe\"\nchecked=[]\nfor row in comparison[\"comparisons\"]:\n name=row[\"step\"]\n assert sha(prior/name)==config[\"reference_step_sha256\"][name]\n current=json.loads((directory/name).read_text());old=json.loads((prior/name).read_text())\n fields={k:math.isclose(current[k],old[k],rel_tol=config[\"comparison_rtol\"],abs_tol=config[\"comparison_atol\"]) for k in [\"loss\",\"gradient_norm\"]}\n assert fields==row[\"fields\"] and all(fields.values())==row[\"passed\"]\n checked.append({\"step\":name,\"fields\":fields,\"loss_relative_difference\":abs(current[\"loss\"]-old[\"loss\"])/abs(old[\"loss\"]),\"gradient_norm_relative_difference\":abs(current[\"gradient_norm\"]-old[\"gradient_norm\"])/abs(old[\"gradient_norm\"])})\nresult[\"comparison\"]=comparison\nresult[\"reconstructed_comparisons\"]=checked\nresult[\"parity_passes\"]=sum(all(x[\"fields\"].values()) for x in checked)\nresult[\"loss_failures\"]=sum(not x[\"fields\"][\"loss\"] for x in checked)\nresult[\"gradient_norm_failures\"]=sum(not x[\"fields\"][\"gradient_norm\"] for x in checked)\nresult[\"optimizer_receipt_status\"]=\"pass\"\nresult[\"overall_status\"]=\"fail\"\nresult[\"compiler_callable_unchanged\"]=True\nresult[\"dynamic_reference_audit_sha256\"]=sha(root/\"research/irc-fit-probe-result-audit-v1.json\")\nresult[\"remaining_stage_seconds_with_reserve\"]=(1-result[\"known_stage_h100_hours\"]-.1)*3600\nresult[\"inference\"]=\"Reject equivalence/adoption under the frozen scalar-parity contract; aggregate trajectory failure alone does not isolate which operator or gradient vector is inaccurate.\"\nresult[\"baseline_eligible\"]=False\nresult[\"retry\"]=False\nprint(json.dumps(result))"
